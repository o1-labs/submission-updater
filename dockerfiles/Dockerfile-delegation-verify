#################################################################################################
# The "stateless verification build" Stage
# - builds stateless verification tool
# - adds submission_updater binary to /bin
#################################################################################################

# Builder image
#
# Source of truth for which toolchain to pin: buildkite/src/Constants/ContainerImages.dhall
# in MinaProtocol/mina, field minaToolchainBullseye.amd64. That file pins this same
# image at both refs we build from (3.5.0-mainnet-stop-slot and 4.0.0-mainnet-mesa);
# the "-devnet" suffix is the toolchain's own build lineage, not a network constraint.
#
# Pinned by tag rather than by digest, on purpose: mina CI pins by tag here, and the
# digest this used to carry was deleted upstream, which broke the build outright.
#
# Declared in global scope (before the first FROM) so both builder stages share a
# single toolchain and cannot drift apart on the next bump.
ARG MINA_TOOLCHAIN=europe-west3-docker.pkg.dev/o1labs-192920/euro-docker-repo/mina-toolchain:f009c00-bullseye-devnet

FROM ${MINA_TOOLCHAIN} AS builder

# Use --build-arg "DUNE_PROFILE=dev" to build a dev image or for CI
ARG DUNE_PROFILE=mainnet

# branch to checkout on first clone (this will be the only availible branch in the container)
# can also be a tagged release
ARG MINA_BRANCH=berkeley

# repo to checkout the branch from
ARG MINA_REPO=https://github.com/MinaProtocol/mina

# location of repo used for pins and external package commits
ARG MINA_DIR=mina

ENV PATH "$PATH:/usr/lib/go/bin:$HOME/.cargo/bin"

# git will clone into an empty dir, but this also helps us set the workdir in advance
RUN cd $HOME && rm -rf $HOME/${MINA_DIR} \
    && git clone \
    -b "${MINA_BRANCH}" \
    --depth 1 \
    --shallow-submodules \
    --recurse-submodules \
    ${MINA_REPO} ${HOME}/${MINA_DIR}

WORKDIR $HOME/${MINA_DIR}

RUN git submodule sync && git submodule update --init --recursive

RUN mkdir ${HOME}/app

# HACK: build without special cpu features to allow more people to run delegation verification tool
# RUN ./scripts/zexe-standardize.sh

RUN eval $(opam config env) \
    && dune build --profile=${DUNE_PROFILE} \
    src/app/delegation_verify/delegation_verify.exe \
    && cp _build/default/src/app/delegation_verify/delegation_verify.exe ./delegation-verify \
    && rm -rf _build

USER root

# copy binary to /bin
RUN cp ./delegation-verify /bin/delegation-verify

#################################################################################################
# The post-hard-fork "stateless verification build" Stage
# - builds the post-hard-fork (Mesa) stateless verification tool
# - skipped entirely when MINA_BRANCH_POST_FORK is empty (an empty placeholder
#   is produced instead so the runtime COPY always succeeds)
#################################################################################################

FROM ${MINA_TOOLCHAIN} AS builder-post-fork

# Use --build-arg "DUNE_PROFILE_POST_FORK=dev" to build a dev image or for CI
ARG DUNE_PROFILE_POST_FORK=mainnet

# branch (or tagged release) to build the post-hard-fork binary from
# when empty (the default) this stage builds nothing and only emits a placeholder
ARG MINA_BRANCH_POST_FORK=""

# repo to checkout the branch from
ARG MINA_REPO=https://github.com/MinaProtocol/mina

# location of repo used for pins and external package commits
ARG MINA_DIR=mina

ENV PATH "$PATH:/usr/lib/go/bin:$HOME/.cargo/bin"

# git will clone into an empty dir, but this also helps us set the workdir in advance
RUN if [ -n "$MINA_BRANCH_POST_FORK" ]; then \
    cd $HOME && rm -rf $HOME/${MINA_DIR} \
    && git clone \
    -b "${MINA_BRANCH_POST_FORK}" \
    --depth 1 \
    --shallow-submodules \
    --recurse-submodules \
    ${MINA_REPO} ${HOME}/${MINA_DIR} \
    ; fi

WORKDIR $HOME/${MINA_DIR}

RUN if [ -n "$MINA_BRANCH_POST_FORK" ]; then \
    git submodule sync && git submodule update --init --recursive \
    ; fi

RUN mkdir -p ${HOME}/app

# HACK: build without special cpu features to allow more people to run delegation verification tool
# RUN ./scripts/zexe-standardize.sh

# DUNE_PROFILE must be exported as an ENVIRONMENT variable, not only passed as
# dune's --profile flag: mina's comptime layer (src/lib/comptime/gen.sh) reads
# the env var and silently falls back to the "dev" profile when it is unset,
# baking dev constraint constants (ledger_depth 10, txn capacity 3) into the
# binary - a different circuit whose verification rejects every real block.
# See MinaProtocol/mina#19294.
RUN if [ -n "$MINA_BRANCH_POST_FORK" ]; then \
    export DUNE_PROFILE="${DUNE_PROFILE_POST_FORK}" \
    && eval $(opam config env) \
    && dune build --profile=${DUNE_PROFILE_POST_FORK} \
    src/app/delegation_verify/delegation_verify.exe \
    && cp _build/default/src/app/delegation_verify/delegation_verify.exe ./delegation-verify \
    && rm -rf _build \
    ; fi

USER root

# copy binary to /bin (empty placeholder when the post-fork build is skipped,
# so the runtime stage COPY below never fails)
RUN if [ -n "$MINA_BRANCH_POST_FORK" ]; then \
    cp ./delegation-verify /bin/delegation-verify-post-fork; \
    else \
    touch /bin/delegation-verify-post-fork; \
    fi

# Runtime image
FROM golang:1.22-bullseye

# Copy resources from builder to runtime image
COPY --from=builder /bin/delegation-verify /bin/delegation-verify
COPY --from=builder-post-fork /bin/delegation-verify-post-fork /bin/delegation-verify-post-fork

RUN apt-get update && apt-get install -y jq libjemalloc2 wget dnsutils gawk

# Install libssl1.1.1b (not in apt)
RUN wget https://www.openssl.org/source/openssl-1.1.1b.tar.gz
RUN mkdir /opt/openssl
RUN tar xfvz openssl-1.1.1b.tar.gz --directory /opt/openssl
RUN rm openssl-1.1.1b.tar.gz

ENV LD_LIBRARY_PATH="$LD_LIBRARY_PATH:/opt/openssl/lib"
ENV PATH="$PATH:/opt/openssl/bin"

RUN cd /opt/openssl/openssl-1.1.1b && ./config --prefix=/opt/openssl --openssldir=/opt/openssl/ssl
RUN cd /opt/openssl/openssl-1.1.1b && make && make install

# Rename openssl old binary
RUN mv /usr/bin/openssl /usr/bin/openssl.old

# Set the Current Working Directory inside the container
WORKDIR $GOPATH/src

# Copy everything from the current directory to the PWD (Present Working Directory) inside the container
COPY src src
COPY database/cert/sf-class2-root.crt /root/.cassandra/sf-class2-root.crt
# copy the whole directory so mainnet-post-fork.json (committed on hard-fork day)
# rides along automatically once it exists
COPY genesis_ledgers/ /root/genesis_ledgers/

# Download all the dependencies
RUN cd src && go get -d -v ./...

# Install the package
RUN cd src && go install -v ./...

# RFC3339 hard-fork cutover time; empty (the default) keeps dual mode off and
# the wrapper behaves exactly as today
ARG FORK_CUTOVER_TIME=""

ENV DELEGATION_VERIFY_BIN_PATH=/bin/delegation-verify
ENV DELEGATION_VERIFY_BIN_PATH_POST_FORK=/bin/delegation-verify-post-fork
ENV SSL_CERTFILE=/root/.cassandra/sf-class2-root.crt
ENV GENESIS_LEDGER_FILE=/root/genesis_ledgers/mainnet.json
ENV GENESIS_LEDGER_FILE_POST_FORK=/root/genesis_ledgers/mainnet-post-fork.json
ENV FORK_CUTOVER_TIME=${FORK_CUTOVER_TIME}

# Run the executable
ENTRYPOINT ["submission_updater"]