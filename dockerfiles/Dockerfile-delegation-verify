#################################################################################################
# submission_updater + delegation-verify
# - submission_updater: built here from src/ (static Go binary)
# - delegation-verify and the network config: released Mina debs from the signed apt repo
#################################################################################################

FROM golang:1.22-bookworm AS go

WORKDIR /build
COPY src/go.mod src/go.sum ./
RUN go mod download
COPY src/ ./
RUN CGO_ENABLED=0 go build -trimpath -o /out/submission_updater .

FROM debian:bookworm-slim

# Mina release to take the verifier and config from, e.g. 4.0.2-84b8d96.
ARG MINA_VERSION
ARG MINA_NETWORK=mainnet
ARG MINA_PROFILE=mainnet
# Version of mina-${MINA_NETWORK}-config that ships the ledger tarballs. Empty = MINA_VERSION.
# Config debs carry the tarballs from MinaProtocol/mina#19737 on; 4.0.1 and 4.0.2 do not,
# so for those point this at 4.0.0-6850301 (same mainnet ledgers).
ARG LEDGER_CONFIG_VERSION=""
ARG MINA_APT_URL=https://stable.apt.packages.minaprotocol.com
ARG MINA_APT_CHANNEL=stable
ARG MINA_APT_KEY_FINGERPRINT=386E9DAC378726A48ED5CE56ADB30D9ACE02F414

SHELL ["/bin/bash", "-euo", "pipefail", "-c"]

RUN test -n "${MINA_VERSION}" || { echo "MINA_VERSION build arg is required" >&2; exit 1; }

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl gpg jq openssl \
    && curl -fsSL "${MINA_APT_URL}/repo-signing-key.gpg" -o /tmp/mina.gpg \
    && gpg --show-keys --with-colons /tmp/mina.gpg | awk -F: '$1=="fpr"{print $10; exit}' | grep -qx "${MINA_APT_KEY_FINGERPRINT}" \
    && install -D -m 0644 /tmp/mina.gpg /etc/apt/keyrings/mina.gpg \
    && rm /tmp/mina.gpg \
    && echo "deb [signed-by=/etc/apt/keyrings/mina.gpg] ${MINA_APT_URL} bookworm ${MINA_APT_CHANNEL}" \
         > /etc/apt/sources.list.d/mina.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
         "mina-delegation-verify=${MINA_VERSION}" \
         "mina-logproc=${MINA_VERSION}" \
         "mina-${MINA_NETWORK}-config=${MINA_VERSION}" \
    && if [[ -n "${LEDGER_CONFIG_VERSION}" && "${LEDGER_CONFIG_VERSION}" != "${MINA_VERSION}" ]]; then \
         cd /tmp \
         && apt-get download "mina-${MINA_NETWORK}-config=${LEDGER_CONFIG_VERSION}" \
         && dpkg-deb --fsys-tarfile mina-"${MINA_NETWORK}"-config_*.deb \
            | tar -x -C / --wildcards './var/lib/coda/*.tar.gz' \
         && rm mina-"${MINA_NETWORK}"-config_*.deb; \
       fi \
    && apt-get purge -y gpg && apt-get autoremove -y \
    && rm -rf /var/lib/apt/lists/*

# Every ledger the config names must be present under /var/lib/coda with the matching
# s3_data_hash. The verifier trusts local files as is and silently falls back to S3
# for missing ones, so a gap here would only show up as egress.
RUN shopt -s nullglob \
    && cfg="/var/lib/coda/${MINA_NETWORK}.json" \
    && declare -A have \
    && for f in /var/lib/coda/*.tar.gz; do \
         have[$(openssl dgst -sha3-256 -r "$f" | cut -d' ' -f1)]="$f"; \
       done \
    && for want in $(jq -r '[.ledger, .epoch_data.staking, .epoch_data.next] | .[] | .s3_data_hash // empty' "$cfg" | sort -u); do \
         [[ -n "${have[$want]:-}" ]] || { echo "no ledger tarball with sha3-256 ${want} (from ${cfg})" >&2; exit 1; }; \
         echo "ledger ${want}: ${have[$want]}"; \
       done

COPY --from=go /out/submission_updater /go/bin/submission_updater
COPY database/cert/sf-class2-root.crt /root/.cassandra/sf-class2-root.crt

ENV PATH="/go/bin:${PATH}"
ENV MINA_PROFILE=${MINA_PROFILE}
ENV SSL_CERTFILE=/root/.cassandra/sf-class2-root.crt
ENV DELEGATION_VERIFY_BIN_PATH=/usr/local/bin/mina-delegation-verify
ENV GENESIS_LEDGER_FILE=/var/lib/coda/${MINA_NETWORK}.json
# One binary serves both partitions, so deployments that still set FORK_CUTOVER_TIME
# keep passing the startup checks.
ENV DELEGATION_VERIFY_BIN_PATH_POST_FORK=/usr/local/bin/mina-delegation-verify
ENV GENESIS_LEDGER_FILE_POST_FORK=/var/lib/coda/${MINA_NETWORK}.json

ENTRYPOINT ["submission_updater"]
